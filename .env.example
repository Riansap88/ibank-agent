# Copy to .env for local testing. NEVER commit a real .env.
# The production secret comes from the platform dashboard (Rotate Secret).
AGENT_GAMES_HMAC_SECRET=
# Optional: Kurier mainnet API key (https://kurier.xyz). Leave blank for
# response-only mode (proof included in the response, no Kurier call).
KURIER_API_KEY=
# Set to false to disable Kurier submission even when a key is present.
KURIER_SUBMIT=true
# HMAC assumption overrides (only change if preflight says the assumption is wrong).
# HMAC_ALGO=sha256
# HMAC_ENCODING=hex
# HMAC_SECRET_ENCODING=utf8
# Steal the VFY: 248-bit salt (31 bytes hex) for the strategy commitment.
# NEVER put the real salt here. Locally it lives in ~/.config/zkverify/steal-salt
# (mode 600); on Vercel set VFY_POLICY_SALT as an env var before Round 1.
# VFY_POLICY_SALT=
# Strategy params (8 ints: probeExtract, catchUpExtract, protectLeadTurn,
# lowBalanceHold, fortifyCost, fortifyBlock, maxExtract, reserved).
# Changing ANY param changes the commitment and needs re-registration.
# VFY_STRATEGY_PARAMS=3,6,15,15,2,6,10,0
